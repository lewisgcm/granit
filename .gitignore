# Rust build artifacts
/target

# Nix build result symlinks
result
result-*

# Generated Nix files live under .granit/ (regenerated by granit from granit.lock)
.granit/

# granit.lock is intentionally tracked (committed) for reproducibility.
# Exception: the example's lock is generated on demand by the e2e test's staged
# copy, so we don't commit a stale pin for it.
examples/**/granit.lock
.idea
